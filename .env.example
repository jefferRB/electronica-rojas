# Copy to .env and replace the placeholder values. Never commit .env.
#   Copy-Item .env.example .env

# PostgreSQL container (read by Docker Compose)
POSTGRES_DB=electronica_rojas
POSTGRES_USER=electronica_rojas
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_HOST_PORT=5433

# Optional first administrator, created at backend startup only if no active admin exists
# (SEC-004). Use a fictitious local address; remove these lines once the admin exists.
# The password needs 12+ characters: the placeholder is deliberately too short, so the
# backend refuses to start until you set your own value.
BOOTSTRAP_ADMIN_EMAIL=admin@electronica-rojas.test
BOOTSTRAP_ADMIN_PASSWORD=CHANGE-ME
BOOTSTRAP_ADMIN_NAME=Administrador

# The backend does NOT read this file directly. scripts/start-backend.ps1 derives
# DB_URL, DB_USERNAME and DB_PASSWORD from the values above for the Java process and
# forwards the BOOTSTRAP_ADMIN_* values when present.

# ---- Customer notifications ----
# Default: e-mails stay in the in-memory development inbox (Notificaciones > Bandeja de desarrollo)
# and never reach real people. Switch to SMTP only once a provider is configured and authorized,
# with credentials of THIS project (never reused from another one).
# MAIL_MODE=inbox
# MAIL_FROM=no-reply@example.test
# PUBLIC_BASE_URL=https://electronica-rojas.example.test
# SPRING_MAIL_HOST=smtp.example.test
# SPRING_MAIL_PORT=587
# SPRING_MAIL_USERNAME=
# SPRING_MAIL_PASSWORD=
